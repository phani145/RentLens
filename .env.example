# RentLens AI Configuration

# Ollama local server host
OLLAMA_HOST=http://localhost:11434

# Vision-capable model for property inspection (e.g., moondream, llama3.2-vision, llava)
DEFAULT_VISION_MODEL=moondream

# Text model for lease document Q&A and RAG
DEFAULT_TEXT_MODEL=gemma3:1b

# Application configuration
APP_ENV=development
MAX_IMAGE_SIZE_MB=15
MAX_PDF_SIZE_MB=25
